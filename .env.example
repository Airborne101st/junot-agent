# Copy to .env and paste your key. .env is gitignored.
GEMINI_API_KEY=

# Optional. Model ids age out; list what your key can use with:
#   uv run python -m junot.client
JUNOT_MODEL=gemini-3.6-flash
# Optional. The cheap model for the retrieval gate.
JUNOT_SMALL_MODEL=gemini-3.5-flash-lite
# Optional. Learn notes from the chat after this many exchanges.
JUNOT_CONSOLIDATE_EVERY=6

# Optional. Where Junot keeps SOUL.md, traces and memory (default ~/.junot).
# Point it at the project's gitignored data/ folder to edit SOUL.md in your IDE:
#   JUNOT_HOME=/absolute/path/to/junot-agent/data
JUNOT_HOME=

# Optional, for the Telegram gateway (uv run python -m junot.telegram).
# Get a token from @BotFather. ALLOWED is a comma-separated list of Telegram
# user ids that may talk to your Junot; anyone else is refused. Leave it empty
# the first time: the bot then tells you your id.
JUNOT_TELEGRAM_TOKEN=
JUNOT_TELEGRAM_ALLOWED=

# Optional, for the web gateway (uv run python -m junot.web).
JUNOT_WEB_PORT=8765
